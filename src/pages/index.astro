---
import NaiveBase from "@/layouts/naive/NaiveBase.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { parseSite, parseImages, resolveImage } from "@/lib/naive";
import siteRaw from "@/content/blog/_data/site.md?raw";
import imagesRaw from "@/content/blog/_data/images.md?raw";

const site = parseSite(siteRaw);
const heroImage = resolveImage(parseImages(imagesRaw).home_hero);
const posts = sortByDate(await getSinglePage("blog"));

const meta = (post: (typeof posts)[number]) => {
  const cat = (post.data.categories?.[0] ?? "").toUpperCase();
  const day = post.data.date ? dateFormat(post.data.date, "MM.dd") : "";
  const mins = readingTime(post.body ?? "").replace(/Mins?\s*read/i, "min").trim();
  return [cat, day, mins].filter(Boolean).join(" · ");
};

const firstHref = posts.length ? `/blog/${posts[0].id}` : "#";
---

<NaiveBase title={site.brand} active="/" bgWord="じゆう">
  <section class="hero">
    <div class="hero-text">
      {site.heroKicker && <div class="kicker">{site.heroKicker}</div>}
      <h1 set:html={site.heroTitle} />
      <span class="sketch-underline"></span>
      {site.heroLede && <p class="lede">{site.heroLede}</p>}
      <a class="readlink mono" href={firstHref}>阅读全文 →<span class="sketch-frame"></span></a>
    </div>
    <div class="plate hero-plate">
      {heroImage ? <img src={heroImage} alt="" /> : <span class="empty" style="position:absolute;inset:0"></span>}
      <span class="sketch-frame soft"></span>
      <div class="ticks"></div>
      {site.credit && (
        <div class="credit">
          <a href={site.creditUrl} target="_blank" rel="noopener">Illustration — {site.credit} ↗</a>
        </div>
      )}
    </div>
  </section>

  <section class="writing">
    <div class="sec-head">
      <h2>最新 · Writing</h2>
      <a class="more" href="/blog">全部 {posts.length} 篇 →</a>
    </div>
    <div class="hrule"></div>
    <div class="index">
      {
        posts.map((post, i) => (
          <>
            <a class="row" href={`/blog/${post.id}`}>
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{post.data.title}</h3>
              <span class="rmeta">{meta(post)}</span>
            </a>
            <div class="hrule"></div>
          </>
        ))
      }
    </div>
  </section>

  <div class="hrule"></div>
  <footer class="foot">
    <span>© 2026 {site.brand}</span>
    <span>Writing · Notes · About</span>
    {site.credit && <span>插画 {site.credit}</span>}
  </footer>
</NaiveBase>

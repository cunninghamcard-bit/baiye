---
import NaiveBase from "@/layouts/naive/NaiveBase.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { parseSite, resolveImage } from "@/lib/naive";
import siteRaw from "@/content/blog/_data/site.md?raw";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = sortByDate(await getSinglePage("blog"));
  const n = posts.length;
  return posts.map((post, i) => ({
    params: { single: post.id },
    props: { post, next: n > 1 ? posts[(i + 1) % n] : null },
  }));
}

const { post, next } = Astro.props;
const site = parseSite(siteRaw);
const { Content } = await render(post);
const { title, description, author, categories, image, date } = post.data;
const cover = resolveImage(image); // 封面：支持 _data/images/ 文件名、/public 路径、http 外链

const cat = (categories?.[0] ?? "").toUpperCase();
const day = date ? dateFormat(date, "yyyy.MM.dd") : "";
const mins = readingTime(post.body ?? "").replace(/Mins?\s*read/i, "min").trim();
const kicker = [cat, day, mins].filter(Boolean).join(" · ");
---

<NaiveBase title={`${title} · ${site.brand}`} active="/" bgWord="じゆう">
  <article class="article">
    <a class="back" href="/">← 返回 · Writing</a>

    <div class={cover ? "art-opener" : "art-opener no-img"}>
      <div class="art-head-col">
        <div class="art-kicker">{kicker}</div>
        <h1 class="art-title">{title}</h1>
        {description && <p class="art-dek">{description}</p>}
        <div class="art-byline">
          <span>by {author}</span>
          {site.credit && (
            <>
              <span>·</span>
              <span>插画 {site.credit}</span>
            </>
          )}
        </div>
      </div>
      {cover && (
        <div class="art-figure">
          <div class="art-hero">
            <img src={cover} alt={title} />
            <span class="sketch-frame soft"></span>
            <div class="ticks"></div>
          </div>
          {site.credit && (
            <p class="art-credit">
              <a href={site.creditUrl} target="_blank" rel="noopener">Illustration — {site.credit} ↗</a>
            </p>
          )}
        </div>
      )}
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>

  <div class="art-foot">
    <div class="hrule"></div>
    <div class="nav-next">
      <span>© 2026 {site.brand}</span>
      {next && <a href={`/blog/${next.id}`}>下一篇 · {next.data.title} →</a>}
    </div>
  </div>
</NaiveBase>

---
import NaiveBase from "@/layouts/naive/NaiveBase.astro";
import { parseNotes, parseSite, fmtNoteDate } from "@/lib/naive";
import notesRaw from "@/content/blog/_data/notes.md?raw";
import siteRaw from "@/content/blog/_data/site.md?raw";

const doc = parseNotes(notesRaw);
const site = parseSite(siteRaw);
---

<NaiveBase title={`${doc.kicker} · ${site.brand}`} active="/notes" bgWord="ノート">
  <section class="notes">
    <div class="notes-kicker">{doc.kicker}</div>
    <h1 class="notes-title">{doc.titleMain} {doc.titleEn && <span class="en">/ {doc.titleEn}</span>}</h1>
    <span class="underline"></span>
    {doc.dek && <p class="notes-dek">{doc.dek}</p>}

    <div class="hrule"></div>
    {
      doc.notes.map((note) => (
        <>
          <div class="note">
            <div class="note-date">{fmtNoteDate(note.date)}</div>
            <div class="note-body" set:html={note.body} />
          </div>
          <div class="hrule"></div>
        </>
      ))
    }
  </section>

  <div class="notes-foot">© 2026 {site.brand} · 共 {doc.notes.length} 条随记</div>
</NaiveBase>

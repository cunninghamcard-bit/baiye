---
import NaiveBase from "@/layouts/naive/NaiveBase.astro";
import { parseNotes, fmtNoteDate } from "@/lib/naive";
import notesRaw from "@/content/blog/_data/notes.md?raw";

const notes = parseNotes(notesRaw);
---

<NaiveBase title="随记 · Notes · 天真 / Naive" active="/notes" bgWord="ノート">
  <section class="notes">
    <div class="notes-kicker">随记 · Notes</div>
    <h1 class="notes-title">随记 <span class="en">/ Notes</span></h1>
    <span class="underline"></span>
    <p class="notes-dek">没写成文章的句子。短的，碎的，但有时比长文更诚实。</p>

    <div class="hrule"></div>
    {
      notes.map((note) => (
        <>
          <div class="note">
            <div class="note-date">{fmtNoteDate(note.date)}</div>
            <div class="note-body" set:html={note.body} />
          </div>
          <div class="hrule"></div>
        </>
      ))
    }
  </section>

  <div class="notes-foot">© 2026 天真 / Naive · 共 {notes.length} 条随记</div>
</NaiveBase>
